# Server Configuration
PORT=3000
NODE_ENV=development # set to 'production' for production builds

# Application URLs
ORIGINE_URL=http://localhost:3001 # Frontend URL (used for CORS and email links)

# JWT Secrets (generate strong random strings for these)
JWT_SECRET=<YOUR_JWT_SECRET_KEY_HERE_PLEASE_CHANGE_ME>
JWT_REFRESH_SECRET=<YOUR_JWT_REFRESH_SECRET_KEY_HERE_PLEASE_CHANGE_ME>

# Pappers API Token (Optional - if not using the hardcoded one in pappersScraper.js)
API_PAPPERS_TOKEN=<YOUR_PAPPERS_API_TOKEN_HERE>

# Database Configuration (PostgreSQL)
# For development, these are often overridden by hardcoded values in src/config/index.js if not set here.
# For production, these MUST be set.
DB_HOST=localhost
DB_PORT=5432 # Default PostgreSQL port
DB_NAME=propecpro_db # Development DB name from src/config/index.js
DB_USER=postgres     # Development DB user from src/config/index.js
DB_PASS=admin        # Development DB password from src/config/index.js
# DB_DIALECT=postgres # This is set in src/config/index.js

# Mail Configuration (Example for Gmail)
# Ensure your mail provider allows SMTP access. For Gmail, you might need an "App Password".
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true # true for port 465 (SSL/TLS), false for port 587 (STARTTLS)
MAIL_USERNAME=<YOUR_SMTP_USERNAME_OR_EMAIL>
MAIL_PASSWORD=<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>
MAIL_FROM_ADDRESS=<YOUR_SENDER_EMAIL_ADDRESS>
MAIL_FROM_NAME="Prospect Pro" # Optional: Name displayed in the "From" field

# Logging Configuration
LOG_LEVEL=info # Options: error, warn, info, http, verbose, debug, silly

# --- Potentially Unused Variables ---
# The variables below this line might be from a different project template (e.g., Laravel)
# or are not directly consumed by this Node.js application's current configuration.
# Review src/config/index.js to see which environment variables are actively used for production.


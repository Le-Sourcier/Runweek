PORT =3000

NODE_ENV=development
APP_DEBUG=true
APP_KEY=<APP_KEY>
APP_URL=<APP_URL>
APP_PORT=8000
APP_NAME=Laravel
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY_GENERATED=true
APP_TIMEZONE=UTC
APP_DEBUGBAR_ENABLED=true

API_PAPPERS_TOKEN=<PAPPERS_TOKEN>

# Allowed url
ORIGINE_URL=<ORIGINE_URL>

# JWT Secret
JWT_SECRET=<JWT_SECRET_KEY>
JWT_REFRESH_SECRET=<JWT_REFRESH_SECRET_KEY>

# Database
DB_DIALECT=postgres
DB_HOST=<DB_HOST_URL>
DB_PORT=3306
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASS=<DB_PASSWORD>
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_ENGINE=InnoDB
# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Redis
SESSION_PATH=/
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DATABASE=0
# Mail
MAIL_MAILER=smtp
MAIL_PORT=465
MAIL_SECURE=true
MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=<MAIL_USERNAME>
MAIL_PASSWORD=<MAIL_PASSWORD>
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=<MAIL_FROM_ADDRESS>
MAIL_FROM_NAME="${APP_NAME}"
